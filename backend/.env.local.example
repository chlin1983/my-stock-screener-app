# ============================================================
#  backend/.env.local — Local Environment Configuration
#  Copy this file to .env.local and fill in YOUR values.
# ============================================================
#
# HOW TO USE:
#   1. Copy this file:  copy .env.local.example .env.local
#   2. Fill in the values below
#   3. Double-click run_scan.bat to start scanning
#
# .env.local is in .gitignore — your secrets stay private.
# ============================================================


# ---------------------------------------------------------------
#  STORAGE MODE
#  'gcs'   → save scan results to Google Cloud Storage (recommended)
#            Results visible on ALL your PCs via Firebase app
#  'local' → save to backend/cache/ on this PC only
# ---------------------------------------------------------------
STORAGE_TYPE=gcs


# ---------------------------------------------------------------
#  GOOGLE CLOUD STORAGE BUCKET NAME
#  The GCS bucket where scan results will be saved.
#
#  To find your bucket name:
#    1. Go to https://console.cloud.google.com/storage
#    2. Select your project
#    3. Copy the bucket name (e.g. my-stock-screener-cache)
# ---------------------------------------------------------------
GCS_BUCKET_NAME=your-bucket-name-here


# ---------------------------------------------------------------
#  GOOGLE CLOUD CREDENTIALS
#
#  Option A — Service Account Key File (recommended for local use):
#    1. Go to https://console.cloud.google.com/iam-admin/serviceaccounts
#    2. Select your project → select a service account
#    3. Keys tab → Add Key → Create new key → JSON
#    4. Save the downloaded .json file somewhere safe
#    5. Set the path below (use forward slashes or double backslashes)
#
#  Option B — Application Default Credentials (gcloud CLI):
#    Run: gcloud auth application-default login
#    Then leave GOOGLE_APPLICATION_CREDENTIALS commented out below.
# ---------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/your-service-account-key.json


# ---------------------------------------------------------------
#  OPTIONAL: Override default scan parameters
#  (Leave commented out to use defaults from config.py)
# ---------------------------------------------------------------
# MA20_TOLERANCE_PCT=0.5
# MA20_MIN_PULLBACK_DAYS=2
